{
  "name": "feedsweep",
  "description": "Tidy up the HTML content in web feeds. Fix feed-specific quirks so content displays in its best possible form.",
  "repository": {
    "type": "git",
    "url": "https://github.com/macieklamberski/feedsweep.git"
  },
  "bugs": {
    "url": "https://github.com/macieklamberski/feedsweep/issues"
  },
  "license": "MIT",
  "author": "Maciej Lamberski",
  "sideEffects": false,
  "keywords": [
    "rss",
    "atom",
    "feed",
    "html",
    "transform",
    "content",
    "sanitize"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./defaults": {
      "types": "./dist/defaults.d.ts",
      "default": "./dist/defaults.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prepare": "lefthook install",
    "build": "tsdown src/index.ts src/defaults.ts --format esm --dts --clean --unbundle --no-fixed-extension"
  },
  "dependencies": {
    "@wordpress/autop": "^4.46.0",
    "highlight.js": "^11.11.1",
    "linkedom": "^0.18.12",
    "linkifyjs": "^4.3.2",
    "srcset": "^5.0.3"
  },
  "peerDependencies": {
    "feedcanon": "^2.0.0-next.3",
    "feedscout": "^2.0.0-next.2"
  },
  "devDependencies": {
    "@types/bun": "^1.3.13",
    "kvalita": "^1.13.0",
    "tsdown": "^0.22.0"
  }
}
