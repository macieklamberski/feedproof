{
  "name": "feedsweep",
  "description": "Tidy up the HTML content in web feeds. Fix feed-specific quirks so content displays in its best possible form.",
  "repository": {
    "type": "git",
    "url": "https://github.com/macieklamberski/feedsweep.git"
  },
  "bugs": {
    "url": "https://github.com/macieklamberski/feedsweep/issues"
  },
  "license": "MIT",
  "author": "Maciej Lamberski",
  "sideEffects": false,
  "keywords": [
    "rss",
    "atom",
    "feed",
    "html",
    "transform",
    "content",
    "sanitize"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./defaults": {
      "types": "./dist/defaults.d.ts",
      "default": "./dist/defaults.js"
    },
    "./linkedom": {
      "types": "./dist/parsers/linkedom.d.ts",
      "default": "./dist/parsers/linkedom.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prepare": "lefthook install",
    "build": "tsdown src/index.ts src/defaults.ts src/parsers/linkedom.ts --format esm --dts --clean --unbundle --no-fixed-extension",
    "test": "bun test",
    "test:linkedom": "DOM_LIBRARY=linkedom bun test",
    "test:jsdom": "DOM_LIBRARY=jsdom bun test",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs"
  },
  "dependencies": {
    "highlight.js": "^11.11.1",
    "html-tag-names": "^2.1.0",
    "linkifyjs": "^4.3.2",
    "mathml-tag-names": "^4.0.0",
    "srcset": "^5.0.3",
    "svg-tag-names": "^3.0.1"
  },
  "peerDependencies": {
    "feedcanon": "^2.0.0-rc.1",
    "feedscout": "^2.0.0-rc.3",
    "linkedom": "^0.18.12"
  },
  "peerDependenciesMeta": {
    "linkedom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/bun": "^1.3.13",
    "@types/jsdom": "^28.0.3",
    "feedcanon": "^2.0.0-rc.1",
    "feedscout": "^2.0.0-rc.3",
    "jsdom": "^30.0.1",
    "kvalita": "^1.16.0",
    "linkedom": "^0.18.13",
    "trousse": "^1.4.0",
    "tsdown": "^0.22.14",
    "vitepress": "^2.0.0-alpha.18"
  }
}
